{
  "rules": {
    "rooms": {
      ".read": "auth != null && auth.token.email == 'sohailcollege2032008@gmail.com'",
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        "answers": {
          "$qIdx": {
            "$userId": {
              ".write": "auth != null && auth.uid == $userId && !data.exists()"
            }
          }
        },
        "reveal_locks": {
          "$qIdx": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists()"
          }
        },
        "next_locks": {
          "$qIdx": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists()"
          }
        }
      }
    },
    "host_rooms": {
      "$hostId": {
        ".read": "auth != null && auth.uid == $hostId",
        ".write": "auth != null && auth.uid == $hostId"
      }
    },
    "duels": {
      ".read": "auth != null && auth.token.email == 'sohailcollege2032008@gmail.com'",
      "$duelId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "answers": {
          "$qIdx": {
            "$userId": {
              ".write": "auth != null",
              "selected_choice": {
                ".validate": "!data.exists() ? (newData.isNumber() && auth.uid == $userId) : newData.val() == data.val()"
              },
              "reaction_time_ms": {
                ".validate": "!data.exists() ? (newData.isNumber() && newData.val() >= 50 && newData.val() <= 65000 && auth.uid == $userId) : newData.val() == data.val()"
              },
              "uid": {
                ".validate": "newData.isString() && newData.val() == (data.exists() ? data.val() : auth.uid)"
              }
            }
          }
        },
        "players": {
          "$uid": {
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() + 2 : 2)"
            }
          }
        }
      }
    },
    "duel_queue": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "duel_presence": {
      "$duelId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "tournament_registrations": {
      "$tournamentId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "tournament_duels": {
      "$tournamentId": {
        "$duelId": {
          ".read": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || data.child('host_uid').val() == auth.uid)",
          ".write": "auth != null && (auth.token.email == 'sohailcollege2032008@gmail.com' || (!data.exists() && newData.child('host_uid').val() == auth.uid) || (data.exists() && data.child('host_uid').val() == auth.uid))",
          "answers": {
            "$qIdx": {
              "$userId": {
                ".write": "auth != null && auth.uid == $userId && root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists()",
                "selected_choice": {
                  ".validate": "!data.exists() ? (newData.isNumber() && auth.uid == $userId) : newData.val() == data.val()"
                },
                "reaction_time_ms": {
                  ".validate": "!data.exists() ? (newData.isNumber() && newData.val() >= 50 && newData.val() <= 65000 && auth.uid == $userId) : newData.val() == data.val()"
                },
                "uid": {
                  ".validate": "newData.isString() && newData.val() == (data.exists() ? data.val() : auth.uid)"
                },
                "is_correct": {
                  ".validate": "false"
                },
                "points_earned": {
                  ".validate": "false"
                },
                "at": {
                  ".validate": "newData.val() == now"
                },
                "reaction_ms_server": {
                  ".validate": "false"
                }
              }
            }
          },
          "players": {
            "$uid": {
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() + 2 : 2)"
              }
            }
          },
          "forfeit_by": {
            ".validate": "newData.isString() && (newData.val() == auth.uid || (root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists() && root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(newData.val()).exists()) || (root.child('tournament_duels').child($tournamentId).child($duelId).child('host_uid').val() == auth.uid && root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(newData.val()).exists()))",
            ".write": "auth != null && (root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists() || root.child('tournament_duels').child($tournamentId).child($duelId).child('host_uid').val() == auth.uid || auth.token.email == 'sohailcollege2032008@gmail.com')"
          },
          "surrender_by": {
            ".validate": "newData.isString() && newData.val() == auth.uid",
            ".write": "auth != null && (root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists() || root.child('tournament_duels').child($tournamentId).child($duelId).child('host_uid').val() == auth.uid || auth.token.email == 'sohailcollege2032008@gmail.com')"
          },
          "status": {
            ".write": "auth != null && (root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists() || root.child('tournament_duels').child($tournamentId).child($duelId).child('host_uid').val() == auth.uid || auth.token.email == 'sohailcollege2032008@gmail.com')",
            ".validate": "newData.isString()"
          },
          "question_started_at": {
            ".write": "auth != null && (root.child('tournament_duels').child($tournamentId).child($duelId).child('host_uid').val() == auth.uid || auth.token.email == 'sohailcollege2032008@gmail.com' || (root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists() && root.child('tournament_duels').child($tournamentId).child($duelId).child('status').val() != 'playing'))",
            ".validate": "newData.isNumber() && newData.val() <= now + 2000"
          },
          "reveal_started_at": {
            ".write": "auth != null && (root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists() || root.child('tournament_duels').child($tournamentId).child($duelId).child('host_uid').val() == auth.uid || auth.token.email == 'sohailcollege2032008@gmail.com')"
          },
          "current_question_index": {
            ".write": "auth != null && (root.child('tournament_duels').child($tournamentId).child($duelId).child('players').child(auth.uid).exists() || root.child('tournament_duels').child($tournamentId).child($duelId).child('host_uid').val() == auth.uid || auth.token.email == 'sohailcollege2032008@gmail.com')",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "tournament_presence": {
      "$tournamentId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "duel_keys": {
      "$tournamentId": {
        "$duelId": {
          ".read": "false",
          ".write": "auth != null && root.child('bracket_live').child($tournamentId).child('meta').child('host_id').val() == auth.uid"
        }
      }
    },
    "bracket_live": {
      "$tournamentId": {
        ".read": "auth != null",
        ".write": "false",
        "meta": {
          "announcement": {
            ".write": "auth != null && root.child('bracket_live').child($tournamentId).child('meta').child('host_id').val() == auth.uid",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "tournament_meta": {
      "$tournamentId": {
        ".read": "auth != null",
        ".write": "false"
      }
    }
  }
}
